# Application
NODE_ENV=development
PORT=5000

# Local PostgreSQL Database
# Replace YOUR_PASSWORD with your actual local PostgreSQL user password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecommarce?schema=public"

# Security & Tokens
JWT_SECRET=ecommerce_dev_access_jwt_secret_key_32chars_long_minimum
JWT_REFRESH_SECRET=ecommerce_dev_refresh_jwt_secret_key_32chars_long_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (Allowed origins, comma-separated)
CORS_ORIGIN=http://localhost:3000
