# Application
NODE_ENV=development
PORT=4000

# Local PostgreSQL Database
# Replace YOUR_PASSWORD with your actual local PostgreSQL user password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecommarce?schema=public"

# Security & Tokens
JWT_SECRET=ecommerce_dev_access_jwt_secret_key_32chars_long_minimum
JWT_REFRESH_SECRET=ecommerce_dev_refresh_jwt_secret_key_32chars_long_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (Allowed origins, comma-separated)
CORS_ORIGIN=http://localhost:3000

# Google OAuth 2.0 (Server-side Authorization Code Flow)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Stripe Payment Gateway (optional — leave blank to disable Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
